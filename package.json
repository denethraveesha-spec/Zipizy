{
  "name": "zipizy",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron desktop",
    "desktop:smoke": "electron desktop --smoke-test",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "format": "prettier --write src desktop scripts tests *.json *.mjs *.yml",
    "format:check": "prettier --check src desktop scripts tests *.json *.mjs *.yml"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.0",
    "astro": "^7.3.2",
    "cropperjs": "^1.6.3",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1"
  },
  "description": "Private everyday tools for files, text and development",
  "author": "Deneth Raveesha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/denethraveesha-spec/Zipizy.git"
  }
}
