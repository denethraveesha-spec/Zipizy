---
import ToolLayout from "../../layouts/ToolLayout.astro";

const howTo = [
  {
    name: "Upload a PDF",
    text: "Click to choose a PDF file, or drag and drop it onto the drop zone.",
  },
  {
    name: "Choose a split mode",
    text: "Extract a specific page range into one new PDF, or split every page into its own PDF file.",
  },
  {
    name: "Download the result",
    text: "A page range downloads as a single PDF. Splitting all pages downloads a ZIP file containing one PDF per page.",
  },
];

const faqs = [
  {
    question: "Is my PDF uploaded to a server?",
    answer:
      "No. Splitting happens entirely in your browser using a client-side PDF library. Your file is read locally and never leaves your device.",
  },
  {
    question: "How do I write a page range?",
    answer:
      "Use commas to separate pages or ranges, like 1-3,5,8-10. That example extracts pages 1 through 3, page 5, and pages 8 through 10, in that order, into a single new PDF.",
  },
  {
    question: "Why do I get a ZIP file when splitting all pages?",
    answer:
      "Browsers don't allow a website to trigger dozens of individual file downloads at once. Bundling every page into one ZIP file keeps it a single download you can then unzip.",
  },
  {
    question: "Can I split a password-protected PDF?",
    answer:
      "No. Encrypted or password-protected PDFs can't be read by the in-browser library used here. Remove the password with your PDF viewer first, then split the unprotected file.",
  },
];
---

<ToolLayout
  title="PDF Split — Extract Pages or Split into Files | Zipizy"
  description="Extract a page range from a PDF, or split every page into its own file, entirely in your browser. Free, private, no sign-up, nothing uploaded."
  toolName="PDF Split"
  intro="Extract a page range from a PDF, or split it into individual pages — free, private, no sign-up required."
  howTo={howTo}
  faqs={faqs}
>
  <div class="pdf-tool">
    <label id="split-drop" for="split-input" class="drop-zone">
      <span class="drop-title">
        Click to add a PDF, or drag and drop it here
      </span>
      <span class="drop-sub">One file at a time</span>
      <input id="split-input" type="file" accept="application/pdf" hidden />
    </label>

    <p id="split-status" class="status" hidden></p>

    <div id="split-panel" class="panel" hidden>
      <p class="file-summary" id="split-file-summary"></p>

      <div class="tabs">
        <button type="button" class="tab-btn active" data-mode="range">
          Extract page range
        </button>
        <button type="button" class="tab-btn" data-mode="all">
          Split every page
        </button>
      </div>

      <div class="mode-panel" data-mode-panel="range">
        <label class="field-label" for="split-range">
          Pages to extract
        </label>
        <input
          id="split-range"
          type="text"
          placeholder="e.g. 1-3,5,8-10"
          spellcheck="false"
        />
        <button id="split-extract" type="button" class="action-btn primary">
          Extract &amp; Download
        </button>
      </div>

      <div class="mode-panel" data-mode-panel="all" hidden>
        <p class="mode-note">
          Every page will be saved as its own PDF, bundled into a single ZIP
          file.
        </p>
        <button id="split-all" type="button" class="action-btn primary">
          Split All &amp; Download ZIP
        </button>
      </div>

      <button id="split-reset" type="button" class="action-btn ghost">
        Choose a different file
      </button>
    </div>
  </div>

  <style>
    .pdf-tool {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .drop-zone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      border: 2px dashed var(--border);
      border-radius: var(--radius-lg);
      padding: 2rem 1rem;
      cursor: pointer;
      text-align: center;
      transition:
        border-color 0.15s ease,
        background 0.15s ease;
    }

    .drop-zone:hover,
    .drop-zone.drag-over {
      border-color: var(--color-primary);
      background: color-mix(in srgb, var(--color-primary) 6%, transparent);
    }

    .drop-title {
      font-weight: 600;
      color: var(--text-primary);
    }

    .drop-sub {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .status {
      margin: 0;
      font-size: 0.85rem;
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-sm);
    }

    .status.error {
      color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    }

    .status.ok {
      color: var(--color-success);
      background: color-mix(in srgb, var(--color-success) 12%, transparent);
    }

    .panel {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }

    .file-summary {
      margin: 0;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .tabs {
      display: flex;
      gap: 0.5rem;
      border-bottom: 1px solid var(--border);
    }

    .tab-btn {
      background: none;
      border: none;
      color: var(--text-secondary);
      font-weight: 600;
      padding: 0.5rem 0.25rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      font-size: 0.9rem;
    }

    .tab-btn.active {
      color: var(--color-primary);
      border-bottom-color: var(--color-primary);
    }

    .mode-panel {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .mode-panel[hidden] {
      display: none;
    }

    .field-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    #split-range {
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.6rem 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.95rem;
    }

    #split-range:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: -1px;
    }

    .mode-note {
      margin: 0;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .action-btn {
      background: var(--bg-primary);
      color: var(--color-primary);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.6rem 1.1rem;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .action-btn:hover {
      border-color: var(--color-primary);
    }

    .action-btn.ghost {
      color: var(--text-secondary);
      align-self: flex-start;
    }

    .action-btn.primary {
      background: var(--color-accent);
      color: var(--color-accent-contrast);
      border: none;
    }

    .action-btn.primary:hover:not(:disabled) {
      opacity: 0.9;
    }

    .action-btn:disabled {
      opacity: 0.4;
      cursor: default;
    }
  </style>

  <script>
    const dropZone = document.getElementById("split-drop") as HTMLLabelElement;
    const fileInput = document.getElementById(
      "split-input",
    ) as HTMLInputElement;
    const status = document.getElementById(
      "split-status",
    ) as HTMLParagraphElement;
    const panel = document.getElementById("split-panel") as HTMLDivElement;
    const fileSummary = document.getElementById("split-file-summary")!;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const modePanels = document.querySelectorAll<HTMLElement>(".mode-panel");
    const rangeInput = document.getElementById(
      "split-range",
    ) as HTMLInputElement;
    const extractBtn = document.getElementById(
      "split-extract",
    ) as HTMLButtonElement;
    const splitAllBtn = document.getElementById(
      "split-all",
    ) as HTMLButtonElement;
    const resetBtn = document.getElementById("split-reset")!;

    let currentFile: File | null = null;
    let currentBytes: ArrayBuffer | null = null;
    let currentPageCount = 0;

    function showStatus(message: string, kind: "ok" | "error") {
      status.textContent = message;
      status.hidden = false;
      status.classList.toggle("ok", kind === "ok");
      status.classList.toggle("error", kind === "error");
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const target = btn.dataset.mode;
        modePanels.forEach((p) => {
          p.hidden = p.dataset.modePanel !== target;
        });
      });
    });

    async function loadFile(file: File) {
      if (
        file.type !== "application/pdf" &&
        !file.name.toLowerCase().endsWith(".pdf")
      ) {
        showStatus("Please choose a PDF file.", "error");
        return;
      }

      status.hidden = true;
      const { PDFDocument } = await import("@cantoo/pdf-lib");

      try {
        const bytes = await file.arrayBuffer();
        const doc = await PDFDocument.load(bytes, { ignoreEncryption: true });
        if (doc.isEncrypted) {
          showStatus(
            "This PDF is encrypted. Remove the password first, then try again.",
            "error",
          );
          return;
        }
        currentFile = file;
        currentBytes = bytes;
        currentPageCount = doc.getPageCount();

        fileSummary.textContent = `${file.name} — ${formatBytes(file.size)} · ${currentPageCount} page${currentPageCount === 1 ? "" : "s"}`;
        panel.hidden = false;
        rangeInput.value = currentPageCount > 1 ? `1-${currentPageCount}` : "1";
      } catch (e) {
        showStatus(
          "Couldn't read this file — it may be corrupted or encrypted.",
          "error",
        );
      }
    }

    fileInput.addEventListener("change", () => {
      if (fileInput.files?.[0]) loadFile(fileInput.files[0]);
      fileInput.value = "";
    });

    ["dragenter", "dragover"].forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.add("drag-over");
      });
    });

    ["dragleave", "drop"].forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.remove("drag-over");
      });
    });

    dropZone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) loadFile(file);
    });

    resetBtn.addEventListener("click", () => {
      currentFile = null;
      currentBytes = null;
      currentPageCount = 0;
      panel.hidden = true;
      status.hidden = true;
    });

    function parseRanges(spec: string, maxPage: number): number[] {
      const indices: number[] = [];
      const tokens = spec
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      if (tokens.length === 0) {
        throw new Error("Enter at least one page or range.");
      }
      for (const token of tokens) {
        const single = token.match(/^(\d+)$/);
        const range = token.match(/^(\d+)-(\d+)$/);
        if (single) {
          const n = Number(single[1]);
          if (n < 1 || n > maxPage)
            throw new Error(`Page ${n} is out of range (1-${maxPage}).`);
          indices.push(n - 1);
        } else if (range) {
          const a = Number(range[1]);
          const b = Number(range[2]);
          if (a < 1 || b > maxPage || a > b)
            throw new Error(
              `Range ${token} is invalid for a ${maxPage}-page PDF.`,
            );
          for (let n = a; n <= b; n++) indices.push(n - 1);
        } else {
          throw new Error(`"${token}" isn't a valid page or range.`);
        }
      }
      return indices;
    }

    function downloadBlob(bytes: BlobPart, filename: string, type: string) {
      const blob = new Blob([bytes], { type });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }

    extractBtn.addEventListener("click", async () => {
      if (!currentBytes) return;
      status.hidden = true;
      try {
        const indices = parseRanges(rangeInput.value, currentPageCount);
        const { PDFDocument } = await import("@cantoo/pdf-lib");
        const src = await PDFDocument.load(currentBytes, {
          ignoreEncryption: true,
        });
        const out = await PDFDocument.create();
        const pages = await out.copyPages(src, indices);
        pages.forEach((p) => out.addPage(p));
        const bytes = await out.save();
        downloadBlob(bytes, "zipizy-extracted.pdf", "application/pdf");
        showStatus(
          `Extracted ${indices.length} page${indices.length === 1 ? "" : "s"} successfully.`,
          "ok",
        );
      } catch (e) {
        showStatus((e as Error).message, "error");
      }
    });

    splitAllBtn.addEventListener("click", async () => {
      if (!currentBytes || !currentFile) return;
      status.hidden = true;
      splitAllBtn.disabled = true;
      showStatus("Splitting…", "ok");

      try {
        const { PDFDocument } = await import("@cantoo/pdf-lib");
        const { zipSync } = await import("fflate");
        const src = await PDFDocument.load(currentBytes, {
          ignoreEncryption: true,
        });
        const baseName = currentFile.name.replace(/\.pdf$/i, "");
        const zipEntries: Record<string, Uint8Array> = {};

        for (let i = 0; i < currentPageCount; i++) {
          const out = await PDFDocument.create();
          const [page] = await out.copyPages(src, [i]);
          out.addPage(page);
          const bytes = await out.save();
          const padded = String(i + 1).padStart(
            String(currentPageCount).length,
            "0",
          );
          zipEntries[`${baseName}-page-${padded}.pdf`] = bytes;
        }

        const zipped = zipSync(zipEntries);
        downloadBlob(
          zipped as unknown as BlobPart,
          "zipizy-split-pages.zip",
          "application/zip",
        );
        showStatus(`Split into ${currentPageCount} files successfully.`, "ok");
      } catch (e) {
        showStatus(`Split failed: ${(e as Error).message}`, "error");
      } finally {
        splitAllBtn.disabled = false;
      }
    });
  </script>
</ToolLayout>
