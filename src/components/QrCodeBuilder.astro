---
interface Props {
  outputName: string;
}

const { outputName } = Astro.props;
---

<div class="qr-builder" data-output-name={outputName}>
  <div class="layout">
    <div class="preview">
      <canvas data-role="canvas" width="300" height="300"></canvas>
      <button
        type="button"
        class="action-btn primary"
        data-role="download"
        disabled
      >
        Download PNG
      </button>
      <p class="status error" data-role="status" hidden></p>
    </div>

    <div class="controls">
      <div class="control-row">
        <label class="control-field">
          Size
          <select data-role="size">
            <option value="200">200 px</option>
            <option value="300" selected>
              300 px
            </option>
            <option value="500">500 px</option>
            <option value="800">800 px</option>
          </select>
        </label>
        <label class="control-field">
          Error correction
          <select data-role="ec">
            <option value="L">L — 7%</option>
            <option value="M" selected>
              M — 15%
            </option>
            <option value="Q">Q — 25%</option>
            <option value="H">H — 30%</option>
          </select>
        </label>
      </div>

      <div class="control-row">
        <label class="color-field">
          Foreground
          <input type="color" value="#000000" data-role="fg" />
        </label>
        <label class="color-field">
          Background
          <input type="color" value="#ffffff" data-role="bg" />
        </label>
      </div>

      <div class="field">
        <label>Logo (optional)</label>
        <div class="logo-row">
          <input type="file" accept="image/*" data-role="logo" />
          <button type="button" class="action-btn ghost" data-role="logo-clear">
            Remove
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .qr-builder {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .preview canvas {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .control-row {
    display: flex;
    gap: 1rem;
  }

  .control-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    flex: 1;
  }

  .control-field select {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.6rem;
  }

  .color-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    flex: 1;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.6rem;
  }

  .color-field input {
    width: 2.5rem;
    height: 1.75rem;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .logo-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-row input[type="file"] {
    color: var(--text-primary);
    font-size: 0.85rem;
    max-width: 100%;
  }

  .action-btn {
    background: var(--bg-primary);
    color: var(--color-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .action-btn:hover {
    border-color: var(--color-primary);
  }

  .action-btn.ghost {
    color: var(--text-secondary);
  }

  .action-btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border: none;
    width: 100%;
  }

  .action-btn.primary:hover:not(:disabled) {
    opacity: 0.9;
  }

  .action-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .status {
    margin: 0;
    font-size: 0.85rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .status.error {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
</style>

<script>
  import { renderQrToCanvas } from "../lib/qrRender";

  document.querySelectorAll<HTMLDivElement>(".qr-builder").forEach((root) => {
    const outputName = root.dataset.outputName ?? "zipizy-qr-code";

    const canvas = root.querySelector<HTMLCanvasElement>(
      '[data-role="canvas"]',
    )!;
    const sizeSelect =
      root.querySelector<HTMLSelectElement>('[data-role="size"]')!;
    const ecSelect = root.querySelector<HTMLSelectElement>('[data-role="ec"]')!;
    const fgInput = root.querySelector<HTMLInputElement>('[data-role="fg"]')!;
    const bgInput = root.querySelector<HTMLInputElement>('[data-role="bg"]')!;
    const logoInput =
      root.querySelector<HTMLInputElement>('[data-role="logo"]')!;
    const logoClearBtn = root.querySelector<HTMLButtonElement>(
      '[data-role="logo-clear"]',
    )!;
    const downloadBtn = root.querySelector<HTMLButtonElement>(
      '[data-role="download"]',
    )!;
    const status = root.querySelector<HTMLParagraphElement>(
      '[data-role="status"]',
    )!;

    let currentText = "";
    let logoImage: HTMLImageElement | null = null;
    let generation = 0;

    async function generate() {
      const token = ++generation;
      try {
        await renderQrToCanvas(
          canvas,
          currentText,
          {
            size: Number(sizeSelect.value),
            errorCorrectionLevel: ecSelect.value as "L" | "M" | "Q" | "H",
            dark: fgInput.value,
            light: bgInput.value,
          },
          logoImage,
        );
        if (token !== generation) return;
        status.hidden = true;
        downloadBtn.disabled = !currentText;
      } catch (e) {
        status.textContent = `Couldn't generate QR code: ${(e as Error).message}`;
        status.hidden = false;
        downloadBtn.disabled = true;
      }
    }

    document.addEventListener("zipizy:qr-payload", ((
      e: CustomEvent<{ text: string }>,
    ) => {
      currentText = e.detail.text;
      generate();
    }) as EventListener);

    sizeSelect.addEventListener("change", generate);
    ecSelect.addEventListener("change", generate);
    fgInput.addEventListener("input", generate);
    bgInput.addEventListener("input", generate);

    logoInput.addEventListener("change", () => {
      const file = logoInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          logoImage = img;
          generate();
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    });

    logoClearBtn.addEventListener("click", () => {
      logoImage = null;
      logoInput.value = "";
      generate();
    });

    downloadBtn.addEventListener("click", () => {
      const url = canvas.toDataURL("image/png");
      const a = document.createElement("a");
      a.href = url;
      a.download = `${outputName}.png`;
      a.click();
    });

    generate();
  });
</script>
