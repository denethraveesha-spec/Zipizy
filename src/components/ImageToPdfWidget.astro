---
interface Props {
  accept: string;
  format: "jpg" | "png" | "heic";
  fileLabel: string;
  outputName: string;
}

const { accept, format, fileLabel, outputName } = Astro.props;
---

<div class="itp-tool" data-format={format} data-output-name={outputName}>
  <label class="drop-zone" data-role="drop">
    <span class="drop-title">
      Click to add {fileLabel} files, or drag and drop them here
    </span>
    <span class="drop-sub">
      You can select multiple files to combine into one PDF
    </span>
    <input type="file" accept={accept} multiple hidden data-role="input" />
  </label>

  <p class="status" data-role="status" hidden></p>

  <ol class="file-list" data-role="list"></ol>

  <div class="actions">
    <span class="summary" data-role="summary"></span>
    <button type="button" class="action-btn ghost" data-role="clear" hidden>
      Clear all
    </button>
    <button
      type="button"
      class="action-btn primary"
      data-role="convert"
      disabled
    >
      Convert to PDF &amp; Download
    </button>
  </div>
</div>

<style>
  .itp-tool {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem 1rem;
    cursor: pointer;
    text-align: center;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .drop-zone:hover,
  .drop-zone.drag-over {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }

  .drop-title {
    font-weight: 600;
    color: var(--text-primary);
  }

  .drop-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .status {
    margin: 0;
    font-size: 0.85rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .status.error {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .status.ok {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
  }

  .file-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.itp-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
  }

  :global(.itp-item .itp-index) {
    color: var(--text-secondary);
    font-size: 0.8rem;
    width: 1.5rem;
    flex-shrink: 0;
  }

  :global(.itp-item .itp-thumb) {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--bg-secondary);
    flex-shrink: 0;
  }

  :global(.itp-item span.itp-thumb) {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  :global(.itp-item .itp-meta) {
    flex: 1;
    min-width: 0;
  }

  :global(.itp-item .itp-name) {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.itp-item .itp-detail) {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  :global(.itp-item .itp-detail.itp-error) {
    color: var(--color-accent);
  }

  :global(.itp-item .itp-btn) {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.55rem;
    font-size: 0.8rem;
    cursor: pointer;
  }

  :global(.itp-item .itp-btn:hover) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  :global(.itp-item .itp-btn:disabled) {
    opacity: 0.35;
    cursor: default;
  }

  :global(.itp-item .itp-btn.itp-remove:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .summary {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-right: auto;
  }

  .action-btn {
    background: var(--bg-primary);
    color: var(--color-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .action-btn:hover {
    border-color: var(--color-primary);
  }

  .action-btn.ghost {
    color: var(--text-secondary);
  }

  .action-btn.primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border: none;
  }

  .action-btn.primary:hover:not(:disabled) {
    opacity: 0.9;
  }

  .action-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  import { convertImagesToPdf, type SourceFormat } from "../lib/imageToPdf";

  interface ImageEntry {
    id: number;
    file: File;
    previewUrl: string;
    error: string | null;
  }

  document.querySelectorAll<HTMLDivElement>(".itp-tool").forEach((root) => {
    const format = root.dataset.format as SourceFormat;
    const outputName = root.dataset.outputName ?? "converted";

    const dropZone =
      root.querySelector<HTMLLabelElement>('[data-role="drop"]')!;
    const fileInput = root.querySelector<HTMLInputElement>(
      '[data-role="input"]',
    )!;
    const status = root.querySelector<HTMLParagraphElement>(
      '[data-role="status"]',
    )!;
    const list = root.querySelector<HTMLOListElement>('[data-role="list"]')!;
    const summary = root.querySelector<HTMLSpanElement>(
      '[data-role="summary"]',
    )!;
    const clearBtn = root.querySelector<HTMLButtonElement>(
      '[data-role="clear"]',
    )!;
    const convertBtn = root.querySelector<HTMLButtonElement>(
      '[data-role="convert"]',
    )!;

    let entries: ImageEntry[] = [];
    let nextId = 1;

    function showStatus(message: string, kind: "ok" | "error") {
      status.textContent = message;
      status.hidden = false;
      status.classList.toggle("ok", kind === "ok");
      status.classList.toggle("error", kind === "error");
    }

    function formatBytes(bytes: number): string {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    }

    function render() {
      list.innerHTML = "";
      entries.forEach((entry, i) => {
        const li = document.createElement("li");
        li.className = "itp-item";

        const idx = document.createElement("span");
        idx.className = "itp-index";
        idx.textContent = `${i + 1}.`;

        const thumb = entry.previewUrl
          ? document.createElement("img")
          : document.createElement("span");
        thumb.className = "itp-thumb";
        if (thumb instanceof HTMLImageElement) {
          thumb.src = entry.previewUrl;
          thumb.alt = "";
        } else {
          thumb.textContent = "🖼";
        }

        const meta = document.createElement("div");
        meta.className = "itp-meta";
        const name = document.createElement("span");
        name.className = "itp-name";
        name.textContent = entry.file.name;
        const detail = document.createElement("span");
        detail.className = entry.error ? "itp-detail itp-error" : "itp-detail";
        detail.textContent = entry.error ?? formatBytes(entry.file.size);
        meta.appendChild(name);
        meta.appendChild(detail);

        const upBtn = document.createElement("button");
        upBtn.type = "button";
        upBtn.className = "itp-btn";
        upBtn.textContent = "↑";
        upBtn.setAttribute("aria-label", "Move " + entry.file.name + " up");
        upBtn.disabled = i === 0;
        upBtn.addEventListener("click", () => moveEntry(i, -1));

        const downBtn = document.createElement("button");
        downBtn.type = "button";
        downBtn.className = "itp-btn";
        downBtn.textContent = "↓";
        downBtn.setAttribute("aria-label", "Move " + entry.file.name + " down");
        downBtn.disabled = i === entries.length - 1;
        downBtn.addEventListener("click", () => moveEntry(i, 1));

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "itp-btn itp-remove";
        removeBtn.textContent = "Remove";
        removeBtn.addEventListener("click", () => {
          URL.revokeObjectURL(entry.previewUrl);
          entries = entries.filter((e) => e.id !== entry.id);
          render();
        });

        li.appendChild(idx);
        li.appendChild(thumb);
        li.appendChild(meta);
        li.appendChild(upBtn);
        li.appendChild(downBtn);
        li.appendChild(removeBtn);
        list.appendChild(li);
      });

      const validCount = entries.filter((e) => !e.error).length;
      summary.textContent = entries.length
        ? `${entries.length} file${entries.length === 1 ? "" : "s"} selected`
        : "";
      clearBtn.hidden = entries.length === 0;
      convertBtn.disabled = validCount === 0;
    }

    function moveEntry(index: number, delta: number) {
      const target = index + delta;
      if (target < 0 || target >= entries.length) return;
      [entries[index], entries[target]] = [entries[target], entries[index]];
      render();
    }

    function addFiles(files: FileList | File[]) {
      const list = Array.from(files);
      if (list.length === 0) return;
      status.hidden = true;

      if (entries.length + list.length > 100) {
        showStatus("Add up to 100 images at a time.", "error");
        return;
      }
      for (const file of list) {
        const allowed =
          format === "jpg"
            ? /\.jpe?g$/i
            : format === "png"
              ? /\.png$/i
              : /\.hei[cf]$/i;
        if (!allowed.test(file.name) || file.size > 50 * 1024 * 1024) {
          showStatus("Choose matching image files up to 50 MB each.", "error");
          continue;
        }
        const entry: ImageEntry = {
          id: nextId++,
          file,
          previewUrl: format === "heic" ? "" : URL.createObjectURL(file),
          error: null,
        };
        entries.push(entry);
      }
      render();
    }

    fileInput.addEventListener("change", () => {
      if (fileInput.files) addFiles(fileInput.files);
      fileInput.value = "";
    });

    (["dragenter", "dragover"] as const).forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.add("drag-over");
      });
    });

    (["dragleave", "drop"] as const).forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.remove("drag-over");
      });
    });

    dropZone.addEventListener("drop", (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files?.length) addFiles(dt.files);
    });

    clearBtn.addEventListener("click", () => {
      entries.forEach((e) => e.previewUrl && URL.revokeObjectURL(e.previewUrl));
      entries = [];
      status.hidden = true;
      render();
    });

    convertBtn.addEventListener("click", async () => {
      const validEntries = entries.filter((e) => !e.error);
      if (validEntries.length === 0) return;

      convertBtn.disabled = true;
      showStatus("Converting…", "ok");

      try {
        const bytes = await convertImagesToPdf(
          validEntries.map((e) => e.file),
          format,
        );
        const blob = new Blob([bytes], { type: "application/pdf" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${outputName}.pdf`;
        a.click();
        URL.revokeObjectURL(url);
        showStatus(
          `Converted ${validEntries.length} image${validEntries.length === 1 ? "" : "s"} successfully.`,
          "ok",
        );
      } catch (e) {
        showStatus(`Conversion failed: ${(e as Error).message}`, "error");
      } finally {
        convertBtn.disabled = entries.filter((e) => !e.error).length === 0;
      }
    });
  });
</script>
